{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Full Stack Debug (Stable)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend-node",
      "program": "${workspaceFolder}/backend-node/src/server.js",
      "runtimeExecutable": "node",
      "envFile": "${workspaceFolder}/backend-node/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Start Frontend",
      "serverReadyAction": {
        "pattern": "Backend running on http://localhost:4000",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    }
  ]
}

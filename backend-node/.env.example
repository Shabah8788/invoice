PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret

# Use either DATABASE_URL or the PG* variables below.
# DATABASE_URL takes precedence if both are set.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_app

# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=invoice_app
# PGHOST=localhost
# PGPORT=5432

# Optional company lookup provider.
# Set these when you have a real Swedish company search API/provider.
# Example shape expected by the backend is documented in src/companyLookup.js.
COMPANY_LOOKUP_API_URL=
COMPANY_LOOKUP_API_KEY=
COMPANY_LOOKUP_API_KEY_HEADER=Authorization

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run App (Frontend + Backend)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Start Frontend + Backend"
    },
    {
      "name": "Backend: Launch Node API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend-node",
      "program": "${workspaceFolder}/backend-node/src/server.js",
      "runtimeExecutable": "node",
      "envFile": "${workspaceFolder}/backend-node/.env",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frontend: Launch Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:frontend",
      "cwd": "${workspaceFolder}"
    }
  ]
}
